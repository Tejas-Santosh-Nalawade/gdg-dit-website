# Organiser area (THE INCURSION 2027 sponsorship system). Copy to .env.local.
# Never commit real values.

# PostgreSQL connection string (e.g. Neon, Supabase, Cloud SQL, or a local server)
DATABASE_URL="postgresql://user:password@host:5432/incursion"

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated Google accounts that become admins on first sign-in.
ORGANISER_BOOTSTRAP_ADMINS=""

# Local development only: enables a sign-in form that skips Google for
# organisers already in the database. Ignored in production builds.
ORGANISER_DEV_LOGIN="false"

# Seed file with the internal roster and budget (kept outside git).
SEED_FILE="prisma/seed-data/incursion.local.json"
